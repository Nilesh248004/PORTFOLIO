# Your live site URL, used for canonical links, the sitemap and social previews.
# Leave blank on Vercel to use the project's production domain automatically.
# Set it once you add a custom domain, e.g. https://nileshk.dev
NEXT_PUBLIC_SITE_URL=

# Contact form (EmailJS). All three are optional: the defaults in src/lib/emailjs.ts are the
# ones your previous site used. Set these only to switch to a different EmailJS account.
# They are public values by design (EmailJS sends from the browser), not secrets.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Optional: calendar link for the "Book a call" button (Calendly, Cal.com...)
NEXT_PUBLIC_CALENDAR_URL=
